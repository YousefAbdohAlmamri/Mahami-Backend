# =========================================================
# Laravel 12 - Git Ignore
# =========================================================

# -------------------------
# Environment & Secrets
# -------------------------
.env
.env.*
!.env.example
!.env.testing.example

# -------------------------
# Dependencies
# -------------------------
/vendor/
/node_modules/

# -------------------------
# Laravel Cache & Runtime
# -------------------------
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*

# Preserve required Laravel storage directories
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# -------------------------
# User Uploads & Generated Files
# -------------------------
/storage/app/private/*
!/storage/app/private/.gitignore

/storage/app/public/*
!/storage/app/public/.gitignore

# Laravel public storage symlink is generated by artisan
/public/storage

# -------------------------
# Compiled Assets & Frontend Build
# -------------------------
/public/build/
/public/hot
/public/mix-manifest.json

# -------------------------
# Testing & Coverage
# -------------------------
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
/clover.xml
/junit.xml

# -------------------------
# IDEs & Editors
# -------------------------
/.idea/
/.vscode/
/*.sublime-workspace
*.swp
*.swo
*~

# -------------------------
# Operating System Files
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# -------------------------
# Logs & Temporary Files
# -------------------------
*.log
*.tmp
*.temp
*.bak
*.old

# -------------------------
# Debugging & Profiling
# -------------------------
/storage/debugbar/
/storage/clockwork/
/public/_debugbar/

# -------------------------
# Local Database Files
# -------------------------
*.sqlite
*.sqlite3
*.db

# -------------------------
# Docker Local Overrides
# -------------------------
docker-compose.override.yml
compose.override.yaml
compose.override.yml

# -------------------------
# Local Development Files
# -------------------------
/Homestead.yaml
/Homestead.json
/.phpunit-watcher.yml
/auth.json

# -------------------------
# Composer Local Artifacts
# -------------------------
composer.phar

# -------------------------
# Laravel Pint / PHPStan / Tools
# -------------------------
.phpunit-watcher.yml
.php-cs-fixer.cache
.phpstan-cache/
.phpstan/

# -------------------------
# Generated API Documentation
# -------------------------
/storage/api-docs/

# -------------------------
# Local Certificates & Keys
# -------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# -------------------------
# Backup Files
# -------------------------
*.sql
*.sql.gz
*.dump
*.bak
*.backup